# Copy this file to .env and fill in the two keys.

# Required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required. Web search. Free key, 1,000 searches a month, no card:
# https://app.tavily.com
TAVILY_API_KEY=

# Optional. Any model on OpenRouter that supports tool calling.
MODEL=deepseek/deepseek-v4.1-flash

# Optional. Checks each message for harmful requests before the agent acts.
# About $0.00004 a message. Set to "off" to rely on the main model's own
# safety; every other guardrail stays on.
GUARD_MODEL=meta-llama/llama-guard-4-12b

# Optional. Daily caps, so a long session cannot burn credits.
# Tavily's free plan is 1,000 searches a month, about 33 a day.
DAILY_SEARCH_LIMIT=50
DAILY_MODEL_SPEND_USD=0.50
